# Auth (NextAuth v5)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
# En prod (Vercel) : AUTH_URL=https://ton-domaine.vercel.app
# Les cookies de session doivent rester cohérents avec l’URL publique (voir src/lib/auth.ts).

# Uploads images (avatars, logos équipe/adversaire) — requis sur Vercel
# Dashboard Vercel → Storage → Create Blob store → connecter au projet
# Le token BLOB_READ_WRITE_TOKEN est injecté automatiquement.
BLOB_READ_WRITE_TOKEN=""
