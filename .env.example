# Copie vers .env en local. Sur Vercel : Settings → Environment Variables.

# Neon Postgres (URL pooled / pooler pour Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Secret NextAuth — obligatoire (openssl rand -base64 32)
AUTH_SECRET="change-me-generate-a-long-random-secret"

# URL publique (prod Vercel)
# AUTH_URL="https://ton-app.vercel.app"

# Seed admin (obligatoire en production)
ADMIN_EMAIL="admin@owroster.local"
ADMIN_PASSWORD="change-me-strong-password-12"
