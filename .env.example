# Copie vers .env en local. Sur Vercel : Settings → Environment Variables.

# Neon Postgres (utiliser l’URL "pooled" / pooler pour Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Secret NextAuth — génère avec: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Optionnel : URL publique du site (Vercel le fournit souvent automatiquement)
# AUTH_URL="https://ton-app.vercel.app"
